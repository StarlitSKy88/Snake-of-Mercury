{
  "name": "snake-of-mercury",
  "version": "1.0.0",
  "description": "Unified Autopilot - Multi-Agent Autonomous Coding Harness",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "harness": "tsx src/main.ts",
    "harness:codex": "HARNESS_ENGINE=codex tsx src/main.ts",
    "harness:debug": "tsx --inspect src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pipeline": "tsx src/main.ts",
    "pipeline:minimax": "HARNESS_ENGINE=minimax tsx src/main.ts",
    "v3": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "discuss": "tsx src/discuss-server.ts",
    "resume": "tsx src/main.ts -- --resume",
    "start": "npm run discuss"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.50.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^1.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
